__pycache__/
*.pyc

# pip packaging build artifacts (pyproject.toml) -- rebuilt with
# `python -m build`, never hand-edited, no reason to commit them.
dist/
build/
*.egg-info/
qontext_memory-*/

# Corpora and derived data are not redistributed here.
#
# wikitext-103/ is 517 MB of someone else's corpus.
# *.qw are weave files built from it (11 MB) — reproducible with seed_weave.py.
# dailydialog_pairs.tsv is derived from DailyDialog, which is CC BY-NC-SA 4.0;
# this repository is PolyForm Noncommercial 1.0.0 (see LICENSE), and shipping
# the derivative would put the two licences in conflict. build_filler.py
# rebuilds it from the original dataset.
wikitext-103/
*.qw
dailydialog_pairs.tsv

# Nothing from a private log directory belongs in a public repository.
RP_Logs/
*.jsonl
